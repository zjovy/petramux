{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "petramux",
  "mainBinaryName": "petramux",
  "version": "0.2.8",
  "identifier": "dev.roost.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "petramux",
        "width": 1200,
        "height": 760,
        "minWidth": 640,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 },
        "backgroundColor": "#0f0f11",
        "dragDropEnabled": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "resources": { "themes/": "themes/" },
    "macOS": { "signingIdentity": "-" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzNjgzMkYxQTY5RjJBRjgKUldUNEtwK204VEpvMHprTXdVUVp2clFHaTNyUk5vYkswNC85em5UQjFVVDU2a0N5TVo4RzhXd20K",
      "endpoints": ["https://github.com/zjovy/petramux/releases/latest/download/latest.json"]
    }
  }
}
